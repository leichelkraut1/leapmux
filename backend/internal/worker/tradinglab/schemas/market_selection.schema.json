{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leapmux.dev/schemas/tradinglab/market-selection.json",
  "title": "Market selection",
  "description": "What the market-data step chose to research. It carries no prices: the lab quotes every selected underlying and contract itself, from the broker, and freezes that snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["symbols", "contracts"],
  "properties": {
    "symbols": {
      "description": "Underlyings to quote, upper case.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,9}$"}
    },
    "contracts": {
      "description": "Option contracts worth researching, by the broker's instrument id (from get_option_instruments).",
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instrument_id"],
        "properties": {
          "instrument_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "why": {"type": "string", "maxLength": 300}
        }
      }
    },
    "catalysts": {
      "description": "Dated events the analysts should know about, each from a research tool's result.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "type", "title", "tool"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,9}$"},
          "type": {"type": "string", "maxLength": 40},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "tool": {"type": "string", "description": "The research tool whose result states this.", "maxLength": 80}
        }
      }
    },
    "notes": {"type": "string", "maxLength": 4000}
  }
}
